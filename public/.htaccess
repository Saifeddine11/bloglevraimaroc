# ── Le Vrai Maroc — Apache Configuration ─────────────────────────────────────
# Place this file in /public so Astro copies it to /dist/.htaccess on build.
# If cPanel or Hostinger hides it, enable "Show hidden files" in the File Manager.

Options -Indexes
DirectoryIndex index.html

# ── HTTPS + www → canonical non-www redirect ──────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Redirect HTTP → HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Redirect www.levraimaroc.com → levraimaroc.com
  RewriteCond %{HTTP_HOST} ^www\.levraimaroc\.com$ [NC]
  RewriteRule ^ https://levraimaroc.com%{REQUEST_URI} [L,R=301]

  # 3. Make Astro's fresh sitemap index the canonical sitemap entry point
  RewriteRule ^sitemap\.xml$ /sitemap-index.xml [R=301,L,NE]
</IfModule>

# ── Custom error pages ────────────────────────────────────────────────────────
ErrorDocument 404 /404.html

# ── Security headers ──────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "^(sitemap.*\.xml|robots\.txt)$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>
  # Note: Content-Security-Policy is intentionally omitted to avoid breaking
  # Formspree, Google Fonts, and future analytics integrations.
</IfModule>

# ── Gzip compression ──────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml text/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff font/woff2
  AddOutputFilterByType DEFLATE application/font-woff application/font-woff2
</IfModule>

# ── Browser caching ───────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — short cache so content updates reach visitors quickly
  ExpiresByType text/html                  "access plus 1 hour"

  # CSS / JS — long cache; Astro fingerprints filenames on each build
  ExpiresByType text/css                   "access plus 1 year"
  ExpiresByType application/javascript     "access plus 1 year"

  # Images — long cache
  ExpiresByType image/webp                 "access plus 1 year"
  ExpiresByType image/jpeg                 "access plus 1 year"
  ExpiresByType image/png                  "access plus 1 year"
  ExpiresByType image/gif                  "access plus 1 year"
  ExpiresByType image/svg+xml              "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"

  # Fonts — long cache
  ExpiresByType font/woff                  "access plus 1 year"
  ExpiresByType font/woff2                 "access plus 1 year"
  ExpiresByType application/font-woff      "access plus 1 year"
  ExpiresByType application/font-woff2     "access plus 1 year"

  # XML / RSS / Sitemap — short cache
  ExpiresByType application/xml            "access plus 1 hour"
  ExpiresByType text/xml                   "access plus 1 hour"
  ExpiresByType application/rss+xml        "access plus 1 hour"

  # JSON — short cache
  ExpiresByType application/json           "access plus 1 hour"
</IfModule>

# ── Prevent access to hidden files ───────────────────────────────────────────
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
# Allow this file itself to be read by Apache
<Files ".htaccess">
  Require all granted
</Files>
