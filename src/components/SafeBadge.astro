---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const levels = [
  'S.A.F.E Review',
  'S.A.F.E Certified',
  'S.A.F.E Prime',
  'S.A.F.E Confidential',
];
---

<figure
  class:list={[
    'relative overflow-hidden rounded-lg border border-rdm-border bg-white p-5 text-rdm-black',
    className,
  ]}
  aria-label="Niveaux de qualification S.A.F.E"
>
  <div class="rounded-lg bg-white p-4">
    <img
      src="/images/safe-logo-official.webp"
      alt="Logo officiel S.A.F.E — Security, Analysis, Fidelity & Expert Guidance"
      class="h-auto w-full object-contain"
      width="1536"
      height="1024"
      loading="lazy"
    />
  </div>

  <div class="mt-5 grid gap-2">
    {levels.map((level) => (
      <div class="flex items-center justify-between gap-3 rounded-lg border border-rdm-border bg-white px-3 py-2">
        <span class="text-xs font-semibold">{level}</span>
        <span class="h-1.5 w-1.5 rounded-full bg-rdm-orange" aria-hidden="true"></span>
      </div>
    ))}
  </div>
</figure>
