<script define:vars={{ contactMessages: { loading: copy.form.loading, idle: copy.labels.sendMessage, required: copy.form.required, success: copy.form.success, error: copy.form.error } }}>
  const contactForm = document.getElementById('contact-form');
  const feedback = document.getElementById('form-feedback');
  const submitBtn = document.getElementById('contact-submit');
  const btnLabel = document.getElementById('contact-btn-label');

  function showContactMessage(text, success) {
    if (!feedback) return;
    feedback.textContent = text;
    feedback.className = ['text-sm text-center font-medium mt-2', success ? 'text-emerald-600' : 'text-red-600'].join(' ');
    feedback.classList.remove('hidden');
  }

  contactForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(contactForm);
    if (!data.get('name') || !data.get('email') || !data.get('subject') || !data.get('message')) {
      showContactMessage(contactMessages.required, false);
      return;
    }
    if (submitBtn) submitBtn.disabled = true;
    if (btnLabel) btnLabel.textContent = contactMessages.loading;
    try {
      const res = await fetch('/send-contact.php', { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      if (res.ok) {
        showContactMessage(contactMessages.success, true);
        contactForm.reset();
      } else {
        showContactMessage(contactMessages.error, false);
      }
    } catch {
      showContactMessage(contactMessages.error, false);
    } finally {
      if (submitBtn) submitBtn.disabled = false;
      if (btnLabel) btnLabel.textContent = contactMessages.idle;
    }
  });

  let currentCategory = 'all';
  let currentQuery = '';
  const items = document.querySelectorAll('.article-item');
  const noResults = document.getElementById('no-results');
  const resultsCount = document.getElementById('results-count');
  const filterBtns = document.querySelectorAll('.category-filter-btn');
  const searchInput = document.getElementById('search-input');

  function applyFilters() {
    let visible = 0;
    items.forEach((item) => {
      const cat = item.dataset.category ?? '';
      const text = [item.dataset.title, item.dataset.excerpt, item.dataset.tags].join(' ');
      const show = (currentCategory === 'all' || cat === currentCategory) && (!currentQuery || text.includes(currentQuery.toLowerCase()));
      item.style.display = show ? '' : 'none';
      if (show) visible += 1;
    });
    noResults?.classList.toggle('hidden', visible > 0);
    if (resultsCount) resultsCount.textContent = `${visible}`;
  }

  filterBtns.forEach((btn) => btn.addEventListener('click', () => {
    currentCategory = btn.dataset.filter ?? 'all';
    filterBtns.forEach((b) => b.classList.remove('active', 'bg-rdm-black', 'text-white'));
    btn.classList.add('active', 'bg-rdm-black', 'text-white');
    applyFilters();
  }));
  searchInput?.addEventListener('input', () => {
    currentQuery = searchInput.value.trim();
    applyFilters();
  });
</script>
