---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import NewsletterBlock from '@/components/NewsletterBlock.astro';
import CategoryIcon from '@/components/CategoryIcon.astro';
import SearchBar from '@/components/SearchBar.astro';
import FaqBlock from '@/components/FaqBlock.astro';
import { CATEGORIES } from '@/data/categories';
import { SITE } from '@/data/site';
import { type Locale, localeMeta } from '@/i18n/config';
import { articleLocale, sortArticlesByDate } from '@/i18n/articles';
import { categoryCopies, homeCopy, safeClusterCopies, safePageCopies, staticPages } from '@/i18n/pages';
import { absoluteUrl, categoryRouteKeys, localizedPath, staticAlternates, withXDefault, type RouteKey } from '@/i18n/routes';
import { ui } from '@/i18n/ui';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
}

const { locale, routeKey } = Astro.props;
const copy = ui[locale];
const localeInfo = localeMeta[locale];
const canonicalURL = absoluteUrl(localizedPath(locale, routeKey));
const alternates = withXDefault(staticAlternates(routeKey));
const allArticles = await getCollection('articles');
const articles = sortArticlesByDate(allArticles.filter((article) => articleLocale(article) === locale));
const categoryEntries = Object.values(CATEGORIES).map((cat) => {
  const key = cat.slug as keyof typeof categoryCopies[typeof locale];
  return {
    ...cat,
    ...categoryCopies[locale][key],
    href: localizedPath(locale, categoryRouteKeys[key]),
  };
});
const currentCategoryKey = Object.entries(categoryRouteKeys).find(([, key]) => key === routeKey)?.[0] as keyof typeof categoryCopies[typeof locale] | undefined;
const isCategoryPage = !!currentCategoryKey;
const clusterPage = safeClusterCopies[locale].find((page) => page.routeKey === routeKey);
const localizedSafeLinkTitle = (key: RouteKey) =>
  key === 'safe' ? 'S.A.F.E' : safeClusterCopies[locale].find((page) => page.routeKey === key)?.primaryKeyword ?? key;
const safeHubCopy = safePageCopies[locale];
const safeCopy = routeKey === 'safe' ? safeHubCopy : undefined;
const safeSupportLinks = {
  fr: [
    { href: '/articles/dahir-maroc-definition', title: 'Définition du dahir au Maroc' },
    { href: '/articles/documents-promoteur-immobilier-maroc', title: 'Documents à demander au promoteur' },
    { href: '/articles/investir-marrakech-2026', title: 'Investir à Marrakech en 2026' },
  ],
  en: [
    { href: '/en/articles/dahir-morocco-definition', title: 'Dahir in Morocco: definition' },
    { href: '/en/articles/real-estate-developer-documents-morocco', title: 'Documents to request from a developer' },
    { href: '/en/articles/investing-marrakech-2026', title: 'Investing in Marrakech in 2026' },
  ],
  es: [
    { href: '/es/articulos/dahir-marruecos-definicion', title: 'Dahir en Marruecos: definición' },
    { href: '/es/articulos/documentos-promotor-inmobiliario-marruecos', title: 'Documentos que pedir al promotor' },
    { href: '/es/articulos/invertir-marrakech-2026', title: 'Invertir en Marrakech en 2026' },
  ],
  nl: [
    { href: '/nl/artikelen/dahir-marokko-definitie', title: 'Dahir in Marokko: definitie' },
    { href: '/nl/artikelen/documenten-vastgoedontwikkelaar-marokko', title: 'Documenten vragen aan de ontwikkelaar' },
    { href: '/nl/artikelen/investeren-marrakech-2026', title: 'Investeren in Marrakech in 2026' },
  ],
}[locale];
const safeLimitCopy = {
  fr: {
    heading: 'Méthode internationale et limites',
    body: safeHubCopy.legalCaution,
    formulasHeading: 'Définition, portée et clarification',
    levelsHeading: 'Statuts méthodologiques',
  },
  en: {
    heading: 'International method and limits',
    body: safeHubCopy.legalCaution,
    formulasHeading: 'Definition, scope and clarification',
    levelsHeading: 'Methodology statuses',
  },
  es: {
    heading: 'Método internacional y límites',
    body: safeHubCopy.legalCaution,
    formulasHeading: 'Definición, alcance y aclaración',
    levelsHeading: 'Estados metodológicos',
  },
  nl: {
    heading: 'Internationale methode en grenzen',
    body: safeHubCopy.legalCaution,
    formulasHeading: 'Definitie, reikwijdte en verduidelijking',
    levelsHeading: 'Methodologische statussen',
  },
}[locale];
const safeOpenGraphDescriptions = {
  fr: "Une méthode internationale propriétaire pour analyser un projet immobilier avant décision d'acquisition.",
  en: 'An international proprietary methodology for evaluating property opportunities before purchase.',
  es: 'Una metodología internacional propietaria para evaluar oportunidades inmobiliarias antes de comprar.',
  nl: 'Een internationale eigen methodologie om vastgoedkansen vóór aankoop te beoordelen.',
}[locale];
const staticCopy =
  routeKey === 'blog' || routeKey === 'about' || routeKey === 'legal' || routeKey === 'privacy' || routeKey === 'notFound'
    ? staticPages[locale][routeKey]
    : undefined;

const pageTitle =
  routeKey === 'home'
    ? undefined
    : isCategoryPage && currentCategoryKey
      ? categoryCopies[locale][currentCategoryKey].metaTitle
      : clusterPage?.metaTitle ?? safeCopy?.metaTitle ?? staticCopy?.metaTitle;
const pageDescription =
  routeKey === 'home'
    ? homeCopy[locale].metaDescription
    : isCategoryPage && currentCategoryKey
      ? categoryCopies[locale][currentCategoryKey].metaDescription
      : clusterPage?.metaDescription ?? safeCopy?.metaDescription ?? staticCopy?.metaDescription ?? homeCopy[locale].metaDescription;

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle ?? homeCopy[locale].metaTitle,
  headline: pageTitle ?? homeCopy[locale].metaTitle,
  description: pageDescription,
  url: canonicalURL,
  inLanguage: localeInfo.htmlLang,
  isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
};

const breadcrumbSchema =
  routeKey === 'home'
    ? undefined
    : {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: copy.labels.home, item: absoluteUrl(localizedPath(locale, 'home')) },
          ...(routeKey !== 'safe' && clusterPage
            ? [{ '@type': 'ListItem', position: 2, name: 'S.A.F.E', item: absoluteUrl(localizedPath(locale, 'safe')) }]
            : []),
          { '@type': 'ListItem', position: clusterPage && routeKey !== 'safe' ? 3 : 2, name: clusterPage?.h1 ?? safeCopy?.h1 ?? pageTitle, item: canonicalURL },
        ],
      };

const faqItems = safeCopy?.faq ?? clusterPage?.faq ?? [];
const faqSchema = faqItems.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      inLanguage: localeInfo.htmlLang,
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    }
  : undefined;

const clusterArticleSchema = clusterPage
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: clusterPage.h1,
      description: clusterPage.metaDescription,
      url: canonicalURL,
      inLanguage: localeInfo.htmlLang,
      image: absoluteUrl(clusterPage.image),
      author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
      publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
      about: ['S.A.F.E', clusterPage.primaryKeyword, ...clusterPage.secondaryKeywords],
    }
  : undefined;

const safeDefinedTermSchema = safeCopy
  ? {
      '@context': 'https://schema.org',
      '@type': 'DefinedTerm',
      name: 'S.A.F.E',
      alternateName: ['SAFE real estate', 'S.A.F.E method', 'S.A.F.E analysis grid'],
      termCode: 'Security, Analysis, Fidelity & Expert Guidance',
      description: safeCopy.intro,
      inLanguage: localeInfo.htmlLang,
      inDefinedTermSet: {
        '@type': 'DefinedTermSet',
        name: 'S.A.F.E real estate methodology',
        url: absoluteUrl(localizedPath(locale, 'safe')),
      },
    }
  : undefined;

const clusterHowToSchema = clusterPage
  ? {
      '@context': 'https://schema.org',
      '@type': 'HowTo',
      name: clusterPage.checklistTitle,
      description: clusterPage.metaDescription,
      inLanguage: localeInfo.htmlLang,
      step: clusterPage.checklistItems.map((item, index) => ({
        '@type': 'HowToStep',
        position: index + 1,
        text: item,
      })),
    }
  : undefined;

const clusterDefinedTermSchema = clusterPage
  ? {
      '@context': 'https://schema.org',
      '@type': 'DefinedTerm',
      name: 'S.A.F.E',
      alternateName: ['SAFE real estate', 'S.A.F.E method', 'S.A.F.E grid'],
      termCode: 'Security, Analysis, Fidelity & Expert Guidance',
      description: safeHubCopy.intro,
      inLanguage: localeInfo.htmlLang,
      inDefinedTermSet: {
        '@type': 'DefinedTermSet',
        name: 'S.A.F.E real estate methodology',
        url: absoluteUrl(localizedPath(locale, 'safe')),
      },
    }
  : undefined;

const home = homeCopy[locale];
const latestArticles = articles.slice(0, 6);
---

<BaseLayout
  title={pageTitle}
  titleSuffix={routeKey !== 'safe'}
  description={pageDescription}
  ogTitle={routeKey === 'safe' ? safeCopy?.h1 : undefined}
  ogDescription={routeKey === 'safe' ? safeOpenGraphDescriptions : undefined}
  twitterTitle={routeKey === 'safe' ? safeCopy?.h1 : undefined}
  twitterDescription={routeKey === 'safe' ? safeOpenGraphDescriptions : undefined}
  canonicalURL={canonicalURL}
  locale={locale}
  alternates={alternates}
  routeKey={routeKey}
  noindex={routeKey === 'notFound' || routeKey === 'legal' || routeKey === 'privacy'}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    {safeDefinedTermSchema && <script type="application/ld+json" set:html={JSON.stringify(safeDefinedTermSchema)} />}
    {clusterArticleSchema && <script type="application/ld+json" set:html={JSON.stringify(clusterArticleSchema)} />}
    {clusterHowToSchema && <script type="application/ld+json" set:html={JSON.stringify(clusterHowToSchema)} />}
    {clusterDefinedTermSchema && <script type="application/ld+json" set:html={JSON.stringify(clusterDefinedTermSchema)} />}
  </Fragment>

  {routeKey === 'home' && (
    <>
      <Hero
        eyebrow={home.heroEyebrow}
        title={home.heroTitle}
        accentLine={home.heroAccent}
        subtitle={home.heroSubtitle}
        cta1={{ label: home.ctaPrimary, href: localizedPath(locale, 'blog') }}
        cta2={{ label: home.ctaSecondary, href: localizedPath(locale, 'analyses') }}
        bgImage="/images/hero-marrakech.webp"
      />

      <section class="py-20" aria-labelledby="edition-heading">
        <div class="container-rdm">
          <div class="text-center max-w-2xl mx-auto mb-12">
            <p class="section-label mb-3 reveal">{home.editionEyebrow}</p>
            <h2 id="edition-heading" class="text-headline font-black text-rdm-black reveal reveal-delay-1">
              {home.editionTitle} <span class="text-rdm-orange">{home.editionAccent}</span>
            </h2>
            <p class="text-rdm-gray mt-4 leading-relaxed reveal reveal-delay-2">{home.editionText}</p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
            {categoryEntries.slice(0, 4).map((card, i) => (
              <a href={card.href} class:list={['group glass-card p-7 hover:shadow-card-hover transition-all duration-300 block reveal', `reveal-delay-${i + 1}`]}>
                <div class:list={['w-11 h-11 rounded-xl flex items-center justify-center mb-5 border', card.bgColor, 'border-rdm-border']}>
                  <span class:list={[card.color]}><CategoryIcon name={card.icon} size={20} /></span>
                </div>
                <h3 class="text-base font-black text-rdm-black mb-2 group-hover:text-rdm-orange transition-colors leading-tight">{card.label}</h3>
                <p class="text-sm text-rdm-gray leading-relaxed mb-5">{card.description}</p>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="py-20 bg-rdm-bg" aria-labelledby="latest-heading">
        <div class="container-rdm">
          <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-10">
            <div>
              <p class="section-label mb-2 reveal">{home.latestEyebrow}</p>
              <h2 id="latest-heading" class="text-headline font-black text-rdm-black reveal reveal-delay-1">
                {home.latestTitle} <span class="text-rdm-orange">{home.latestAccent}</span>
              </h2>
            </div>
            <a href={localizedPath(locale, 'blog')} class="text-sm font-semibold text-rdm-orange hover:underline hidden sm:block reveal">
              {copy.labels.allArticles}
            </a>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {latestArticles.map((article) => <ArticleCard article={article} locale={locale} />)}
          </div>
        </div>
      </section>

      <section class="py-20" aria-labelledby="rubriques-heading">
        <div class="container-rdm">
          <div class="text-center max-w-xl mx-auto mb-12">
            <p class="section-label mb-3 reveal">{home.rubriquesEyebrow}</p>
            <h2 id="rubriques-heading" class="text-headline font-black text-rdm-black reveal reveal-delay-1">
              {home.rubriquesTitle}<br /><span class="text-rdm-orange">{home.rubriquesAccent}</span>
            </h2>
            <p class="text-rdm-gray mt-4 leading-relaxed reveal reveal-delay-2">{home.rubriquesText}</p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {categoryEntries.map((cat) => (
              <a href={cat.href} class="group glass-card p-6 hover:shadow-card-hover transition-all duration-300">
                <div class:list={['w-10 h-10 rounded-xl flex items-center justify-center mb-4', cat.bgColor]}>
                  <span class:list={[cat.color]}><CategoryIcon name={cat.icon} size={20} /></span>
                </div>
                <h3 class="font-black text-rdm-black mb-2 group-hover:text-rdm-orange transition-colors">{cat.labelPlural}</h3>
                <p class="text-sm text-rdm-gray leading-relaxed">{cat.description}</p>
              </a>
            ))}
          </div>
        </div>
      </section>

      <NewsletterBlock locale={locale} />
    </>
  )}

  {routeKey === 'blog' && staticCopy && (
    <>
      <section class="py-16 bg-rdm-bg border-b border-rdm-border">
        <div class="container-rdm">
          <p class="section-label mb-3">{staticCopy.eyebrow}</p>
          <h1 class="text-headline font-black text-rdm-black mb-4">{staticCopy.h1}</h1>
          <p class="text-rdm-gray max-w-xl mb-8">{staticCopy.intro}</p>
          <div class="flex flex-col md:flex-row gap-4 items-start md:items-center">
            <div class="w-full md:w-72">
              <SearchBar placeholder={`${copy.labels.search}…`} label={copy.labels.search} />
            </div>
            <div class="flex flex-wrap gap-2" role="group" aria-label={copy.labels.categories}>
              <button data-filter="all" class="category-filter-btn active category-badge bg-rdm-black text-white text-xs">{copy.labels.all}</button>
              {categoryEntries.map((cat) => (
                <button data-filter={cat.key} class:list={['category-filter-btn category-badge text-xs transition-all duration-150', cat.color, cat.bgColor]}>
                  <CategoryIcon name={cat.icon} size={18} />{cat.label}
                </button>
              ))}
            </div>
          </div>
        </div>
      </section>
      <section class="py-14">
        <div class="container-rdm">
          <p class="text-sm text-rdm-gray mb-6" id="results-count">{articles.length} {copy.labels.allArticles.toLowerCase()}</p>
          <div id="articles-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {articles.map((article) => (
              <div data-category={article.data.category} data-title={article.data.title.toLowerCase()} data-excerpt={article.data.excerpt.toLowerCase()} data-tags={article.data.tags.join(' ').toLowerCase()} class="article-item">
                <ArticleCard article={article} locale={locale} />
              </div>
            ))}
          </div>
          <div id="no-results" class="hidden text-center py-16">
            <p class="text-xl font-bold text-rdm-black mb-2">{copy.labels.noResults}</p>
            <p class="text-rdm-gray text-sm">{copy.labels.noResultsHint}</p>
          </div>
        </div>
      </section>
    </>
  )}

  {isCategoryPage && currentCategoryKey && (
    <>
      <section class="py-16 bg-rdm-bg border-b border-rdm-border">
        <div class="container-rdm">
          <div class="flex items-center gap-3 mb-4">
            <CategoryIcon name={CATEGORIES[currentCategoryKey].icon} size={30} class={CATEGORIES[currentCategoryKey].color} />
            <p class="section-label">{categoryCopies[locale][currentCategoryKey].label}</p>
          </div>
          <h1 class="text-headline font-black text-rdm-black mb-4">
            {categoryCopies[locale][currentCategoryKey].title}<br />
            <span class="text-rdm-orange">{categoryCopies[locale][currentCategoryKey].accent}</span>
          </h1>
          <p class="text-rdm-gray max-w-lg leading-relaxed">{categoryCopies[locale][currentCategoryKey].description}</p>
        </div>
      </section>
      <section class="py-14">
        <div class="container-rdm">
          {articles.filter((article) => article.data.category === currentCategoryKey).length > 0 ? (
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
              {articles.filter((article) => article.data.category === currentCategoryKey).map((article) => <ArticleCard article={article} locale={locale} />)}
            </div>
          ) : (
            <p class="text-rdm-gray py-12 text-center">{copy.labels.articleComing}</p>
          )}
        </div>
      </section>
      <NewsletterBlock locale={locale} />
    </>
  )}

  {(routeKey === 'about' || routeKey === 'legal' || routeKey === 'privacy' || routeKey === 'notFound') && staticCopy && (
    <>
      <section class="py-20 bg-rdm-bg border-b border-rdm-border">
        <div class="container-rdm max-w-3xl">
          <p class="section-label mb-4">{staticCopy.eyebrow}</p>
          <h1 class="text-headline font-black text-rdm-black mb-6">{staticCopy.h1}</h1>
          <p class="text-lg text-rdm-gray leading-relaxed">{staticCopy.intro}</p>
        </div>
      </section>
      <section class="py-16">
        <div class="container-rdm max-w-3xl">
          <div class="prose prose-rdm prose-lg max-w-none">
            {staticCopy.sections?.map((section) => (
              <>
                <h2>{section.heading}</h2>
                {section.body.map((paragraph) => <p>{paragraph}</p>)}
                {section.bullets && <ul>{section.bullets.map((item) => <li>{item}</li>)}</ul>}
              </>
            ))}
            {routeKey === 'notFound' && (
              <p>
                <a href={localizedPath(locale, 'home')}>{copy.labels.home}</a> · <a href={localizedPath(locale, 'blog')}>{copy.labels.allArticles}</a>
              </p>
            )}
          </div>
        </div>
      </section>
      {routeKey === 'about' && <NewsletterBlock locale={locale} />}
    </>
  )}

  {routeKey === 'contact' && (
    <section class="py-20">
      <div class="container-rdm">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
          <div>
            <p class="section-label mb-4">{copy.form.writeUs}</p>
            <h1 class="text-headline font-black text-rdm-black mb-5">
              {copy.form.title}<br /><span class="text-rdm-orange">{copy.form.accent}</span>
            </h1>
            <p class="text-rdm-gray leading-relaxed mb-8">{copy.form.body}</p>
            <div class="space-y-5">
              <div class="flex items-start gap-4"><div class="w-10 h-10 rounded-xl bg-rdm-orange-soft flex items-center justify-center flex-shrink-0">✉</div><div><p class="font-semibold text-rdm-black text-sm mb-0.5">{copy.form.emailEditorial}</p><a href={`mailto:${SITE.email}`} class="text-rdm-orange text-sm hover:underline">{SITE.email}</a></div></div>
              <div class="flex items-start gap-4"><div class="w-10 h-10 rounded-xl bg-rdm-orange-soft flex items-center justify-center flex-shrink-0">?</div><div><p class="font-semibold text-rdm-black text-sm mb-0.5">{copy.form.suggestions}</p><p class="text-rdm-gray text-sm">{copy.form.suggestionsText}</p></div></div>
              <div class="flex items-start gap-4"><div class="w-10 h-10 rounded-xl bg-rdm-orange-soft flex items-center justify-center flex-shrink-0">+</div><div><p class="font-semibold text-rdm-black text-sm mb-0.5">{copy.form.partnerships}</p><p class="text-rdm-gray text-sm">{copy.form.partnershipsText}</p></div></div>
            </div>
            <div class="mt-8 p-4 rounded-xl bg-amber-50 border border-amber-200">
              <p class="text-xs text-amber-700"><strong>{copy.labels.disclaimerTitle} :</strong> {copy.form.warning}</p>
            </div>
          </div>
          <form id="contact-form" action="/send-contact.php" method="POST" class="rounded-2xl border border-rdm-border bg-white p-8 shadow-card space-y-5" novalidate aria-label={copy.labels.contact}>
            <input type="hidden" name="_subject" value={`Nouveau message — Le Vrai Maroc (${locale})`} />
            <input type="hidden" name="locale" value={locale} />
            <input type="hidden" name="form_type" value="contact" />
            <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div>
              <label for="contact-name" class="block text-sm font-semibold text-rdm-black mb-1.5">{copy.form.name} <span class="text-rdm-orange">*</span></label>
              <input id="contact-name" name="name" type="text" required autocomplete="name" placeholder={copy.form.namePlaceholder} class="w-full px-4 py-3 rounded-xl border border-rdm-border text-rdm-black text-sm placeholder:text-rdm-gray focus:outline-none focus:ring-2 focus:ring-rdm-orange/20 focus:border-rdm-orange transition-all" />
            </div>
            <div>
              <label for="contact-email" class="block text-sm font-semibold text-rdm-black mb-1.5">{copy.form.email} <span class="text-rdm-orange">*</span></label>
              <input id="contact-email" name="email" type="email" required autocomplete="email" placeholder={copy.newsletter.emailPlaceholder} class="w-full px-4 py-3 rounded-xl border border-rdm-border text-rdm-black text-sm placeholder:text-rdm-gray focus:outline-none focus:ring-2 focus:ring-rdm-orange/20 focus:border-rdm-orange transition-all" />
            </div>
            <div>
              <label for="contact-subject" class="block text-sm font-semibold text-rdm-black mb-1.5">{copy.form.subject} <span class="text-rdm-orange">*</span></label>
              <select id="contact-subject" name="subject" required class="w-full px-4 py-3 rounded-xl border border-rdm-border text-rdm-black text-sm focus:outline-none focus:ring-2 focus:ring-rdm-orange/20 focus:border-rdm-orange transition-all bg-white">
                <option value="">{copy.form.chooseSubject}</option>
                {copy.form.subjects.map(([value, label]) => <option value={value}>{label}</option>)}
              </select>
            </div>
            <div>
              <label for="contact-message" class="block text-sm font-semibold text-rdm-black mb-1.5">{copy.form.message} <span class="text-rdm-orange">*</span></label>
