---
import ArticleCard from './ArticleCard.astro';
import type { CollectionEntry } from 'astro:content';
import { type Locale } from '@/i18n/config';
import { ui } from '@/i18n/ui';

interface Props {
  articles: CollectionEntry<'articles'>[];
  title?: string;
  locale?: Locale;
}

const { articles, locale = 'fr' } = Astro.props;
const title = Astro.props.title ?? ui[locale].labels.relatedArticles;
---

{articles.length > 0 && (
  <section class="py-16 bg-rdm-bg" aria-labelledby="related-heading">
    <div class="container-rdm">
      <div class="flex items-center gap-4 mb-8">
        <div class="w-8 h-px bg-rdm-orange"></div>
        <h2 id="related-heading" class="text-lg font-bold text-rdm-black">{title}</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {articles.slice(0, 3).map((article) => (
          <ArticleCard article={article} locale={locale} />
        ))}
      </div>
    </div>
  </section>
)}
