---
/**
 * CategoryIcon — renders a Lucide-style SVG icon by name.
 * Supported names match the icon slugs in src/data/categories.ts
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className = '' } = Astro.props;

// Inline Lucide SVG paths
const PATHS: Record<string, string[]> = {
  'building-2': [
    'M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z',
    'M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2',
    'M22 22h-2',
    'M18 9h.01',
    'M18 13h.01',
    'M14 9h.01',
    'M14 13h.01',
    'M10 9h.01',
    'M10 13h.01',
    'M10 17h.01',
    'M14 17h.01',
  ],
  'plane': [
    'M17.8 19.2 16 11l3.5-3.5C21 6 21 4 19.5 2.5S18 1 16.5 2.5L13 6 4.8 4.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 5.5 5.3c.4.4.9.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z',
  ],
  'trending-up': [
    'M22 7 13.5 15.5l-5-5L2 17',
    'M16 7h6v6',
  ],
  'map-pin': [
    'M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z',
    'M12 10a2 2 0 1 0-4 0 2 2 0 0 0 4 0',
  ],
  'clipboard-list': [
    'M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2',
    'M9 2h6a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1z',
    'M9 12h6',
    'M9 16h6',
    'M9 8h.01',
  ],
  'search': [
    'M21 21l-4.35-4.35',
    'M11 19A8 8 0 1 0 11 3a8 8 0 0 0 0 16z',
  ],
  'file-text': [
    'M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z',
    'M14 2v4a2 2 0 0 0 2 2h4',
    'M10 9H8',
    'M16 13H8',
