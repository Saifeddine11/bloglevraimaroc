const pathList = PATHS[name] ?? PATHS['file-text'];
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['inline-block flex-shrink-0', className]}
  aria-hidden="true"
  focusable="false"
>
  {pathList.map((d) => <path d={d} />)}
</svg>
