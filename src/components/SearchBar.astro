---
interface Props {
  placeholder?: string;
  initialQuery?: string;
}
const { placeholder = 'Rechercher un article…', initialQuery = '' } = Astro.props;
---

<div class="relative" role="search">
  <label for="search-input" class="sr-only">Rechercher</label>
  <svg
    class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-rdm-gray pointer-events-none"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
  </svg>
  <input
    type="search"
    id="search-input"
    name="q"
    value={initialQuery}
    placeholder={placeholder}
    class="search-input"
    autocomplete="off"
    spellcheck="false"
  />
</div>
