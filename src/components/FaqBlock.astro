---
interface Props {
  items: { question: string; answer: string }[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <section class="py-16 bg-rdm-bg">
    <div class="container-rdm max-w-3xl">
      <h2 class="text-2xl font-black text-rdm-black mb-8">FAQ</h2>
      <div class="space-y-4">
        {items.map((item) => (
          <details class="rounded-xl border border-rdm-border bg-white p-5">
            <summary class="cursor-pointer font-bold text-rdm-black">{item.question}</summary>
            <p class="mt-3 text-sm leading-relaxed text-rdm-gray">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
)}
