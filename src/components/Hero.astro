---
interface Props {
  title: string;
  subtitle?: string;
  cta1?: { label: string; href: string };
  cta2?: { label: string; href: string };
  eyebrow?: string;
  bgImage?: string;
}

const {
  title,
  subtitle,
  cta1,
  cta2,
  eyebrow,
  bgImage = '/images/hero-marrakech.webp',
} = Astro.props;
---

<section class="relative min-h-[85vh] flex items-center overflow-hidden bg-rdm-black" aria-label="Hero">
  <!-- Background image with parallax -->
  <div
    class="absolute inset-0 hero-parallax"
    id="hero-bg"
    aria-hidden="true"
    style="will-change: transform;"
  >
    <img
      src={bgImage}
      alt="Vue aérienne de Marrakech"
      class="w-full h-full object-cover opacity-40"
      loading="eager"
      fetchpriority="high"
      width="1920"
      height="1080"
    />
    <!-- Gradient overlay -->
    <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
  </div>

  <!-- Decorative orange line -->
  <div class="absolute left-0 top-0 bottom-0 w-1 bg-rdm-orange" aria-hidden="true"></div>

  <!-- Content -->
  <div class="container-rdm relative z-10 py-24 lg:py-32">
    <div class="max-w-3xl">
      {eyebrow && (
        <div class="flex items-center gap-3 mb-6 reveal">
          <div class="w-8 h-px bg-rdm-orange"></div>
          <p class="section-label text-white/70">{eyebrow}</p>
        </div>
      )}

      <h1 class="text-display font-black text-white mb-6 reveal reveal-delay-1">
        {title.split('|').map((part, i) => (
          i % 2 === 1
            ? <span class="text-rdm-orange">{part}</span>
            : <span>{part}</span>
        ))}
      </h1>

      {subtitle && (
        <p class="text-lg lg:text-xl text-white/70 leading-relaxed mb-10 max-w-xl reveal reveal-delay-2">
          {subtitle}
        </p>
      )}

      <div class="flex flex-wrap gap-4 reveal reveal-delay-3">
        {cta1 && (
          <a href={cta1.href} class="btn-orange text-sm font-semibold px-7 py-3.5">
            {cta1.label}
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        )}
        {cta2 && (
          <a
            href={cta2.href}
            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full border border-white/30 text-white text-sm font-semibold hover:border-white/60 hover:bg-white/10 transition-all duration-200"
          >
            {cta2.label}
          </a>
        )}
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/40" aria-hidden="true">
    <span class="text-[10px] uppercase tracking-widest">Découvrir</span>
    <div class="w-px h-10 bg-white/20 relative overflow-hidden">
      <div class="absolute top-0 left-0 right-0 h-5 bg-white/60 animate-bounce" style="animation-duration: 1.5s;"></div>
    </div>
  </div>
</section>

<script>
  // Subtle parallax on hero bg
  const heroBg = document.getElementById('hero-bg');
  if (heroBg && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const onScroll = () => {
      const y = window.scrollY;
      heroBg.style.transform = `translateY(${y * 0.3}px)`;
    };
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
