---
import { SITE } from '@/data/site';
const pathname = Astro.url.pathname;
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  style="--header-h: 72px;"
>
  <!-- Glass background (applied via JS on scroll) -->
  <div
    id="header-bg"
    class="absolute inset-0 border-b border-rdm-border opacity-0 transition-all duration-300"
    style="background: rgba(255,255,255,0.85); backdrop-filter: blur(20px) saturate(180%); -webkit-backdrop-filter: blur(20px) saturate(180%);"
    aria-hidden="true"
  ></div>

  <div class="container-rdm relative">
    <div class="flex items-center justify-between h-[72px]">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 group" aria-label={`${SITE.name} — Accueil`}>
        <!-- Brand mark: Moroccan star emblem -->
        <div class="w-8 h-8 rounded-lg bg-rdm-black flex items-center justify-center flex-shrink-0 group-hover:bg-rdm-orange transition-colors duration-200">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <!-- 8-pointed Moroccan star -->
            <path
              d="M12 2 L13.5 9 L20 7 L15 12 L20 17 L13.5 15 L12 22 L10.5 15 L4 17 L9 12 L4 7 L10.5 9 Z"
              fill="white"
              stroke="none"
            />
          </svg>
        </div>
        <!-- Wordmark -->
        <div class="hidden sm:block leading-none">
          <div class="font-black text-rdm-black text-[13px] tracking-[0.04em] uppercase">Le Vrai</div>
          <div class="font-black text-rdm-orange text-[15px] tracking-[0.02em] uppercase -mt-0.5">Maroc</div>
        </div>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Navigation principale">
        {SITE.nav.map((item) => {
          const isActive = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
          return (
            <a
              href={item.href}
              class:list={[
                'px-4 py-2 rounded-full text-sm font-medium transition-all duration-150',
                isActive
                  ? 'bg-rdm-black text-white'
                  : 'text-rdm-black hover:bg-rdm-bg',
              ]}
              aria-current={isActive ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Right side -->
      <div class="flex items-center gap-3">
        <!-- Newsletter CTA (desktop) -->
        <a
          href="/#newsletter"
          class="hidden lg:inline-flex items-center gap-2 px-4 py-2 rounded-full bg-rdm-orange text-white text-sm font-semibold hover:bg-rdm-orange-mid transition-colors duration-150"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
          </svg>
          Newsletter
        </a>

        <!-- Mobile menu toggle -->
        <button
          id="menu-toggle"
          class="lg:hidden p-2 rounded-xl hover:bg-rdm-bg transition-colors"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Ouvrir le menu"
        >
          <svg id="icon-open" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
          <svg id="icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden absolute top-full left-0 right-0 bg-white border-b border-rdm-border shadow-glass"
    aria-label="Menu mobile"
  >
    <nav class="container-rdm py-4 flex flex-col gap-1">
      {SITE.nav.map((item) => {
        const isActive = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
        return (
          <a
            href={item.href}
            class:list={[
              'px-4 py-3 rounded-xl text-sm font-medium transition-colors duration-150',
              isActive
                ? 'bg-rdm-orange-soft text-rdm-orange font-semibold'
                : 'text-rdm-black hover:bg-rdm-bg',
            ]}
          >
            {item.label}
          </a>
        );
      })}
      <div class="pt-3 mt-2 border-t border-rdm-border">
        <a
          href="/#newsletter"
          class="flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-rdm-orange text-white text-sm font-semibold"
        >
          Newsletter
        </a>
      </div>
    </nav>
  </div>
</header>

<!-- Spacer to offset fixed header -->
<div class="h-[72px]" aria-hidden="true"></div>

<script>
  const header = document.getElementById('site-header');
  const headerBg = document.getElementById('header-bg');
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  // Scroll behaviour — glass + subtle shadow
  const onScroll = () => {
    const scrolled = window.scrollY > 20;
    if (headerBg) {
      headerBg.style.opacity = scrolled ? '1' : '0';
      headerBg.style.boxShadow = scrolled ? '0 1px 0 rgba(0,0,0,0.06), 0 4px 24px rgba(0,0,0,0.06)' : 'none';
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Mobile menu toggle
  menuToggle?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.contains('hidden') === false;
    mobileMenu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
    menuToggle.setAttribute('aria-expanded', String(!isOpen));
  });

  // Close mobile menu on link click
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      menuToggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
