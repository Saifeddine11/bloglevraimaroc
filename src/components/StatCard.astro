---
interface Props {
  value: string;
  label: string;
  description?: string;
  trend?: string;
  trendUp?: boolean;
  source?: string;
}

const { value, label, description, trend, trendUp = true, source } = Astro.props;
---

<div class="glass-card p-6 hover:shadow-card-hover transition-shadow duration-300 group">
  <div class="flex items-start justify-between mb-3">
    <span class="stat-number text-rdm-orange group-hover:scale-105 transition-transform duration-200 inline-block origin-left">
      {value}
    </span>
    {trend && (
      <span class:list={[
        'inline-flex items-center gap-1 text-xs font-semibold px-2 py-1 rounded-full',
        trendUp ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700',
      ]}>
        <svg class:list={['w-3 h-3', trendUp ? '' : 'rotate-180']} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5L12 3m0 0l7.5 7.5M12 3v18" />
        </svg>
        {trend}
      </span>
    )}
  </div>
  <p class="font-semibold text-rdm-black text-sm mb-1">{label}</p>
  {description && <p class="text-rdm-gray text-xs leading-relaxed">{description}</p>}
  {source && <p class="text-[10px] text-rdm-gray/60 mt-3 italic">{source}</p>}
</div>
