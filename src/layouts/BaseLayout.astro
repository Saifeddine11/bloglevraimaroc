---
import { SITE } from '@/data/site';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { getLocaleFromPathname, localeMeta, type Locale } from '@/i18n/config';
import { alternatesForPath, localizedPath, type RouteKey } from '@/i18n/routes';
import { homeCopy } from '@/i18n/pages';
import '../styles/global.css';

interface Props {
  title?: string;
  titleSuffix?: boolean;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  canonicalURL?: string;
  article?: boolean;
  publishDate?: Date;
  noindex?: boolean;
  locale?: Locale;
  alternates?: Record<Locale | 'x-default', string>;
  routeKey?: RouteKey;
}

const {
  title,
  titleSuffix = true,
  description,
  ogTitle,
  ogDescription,
  ogImage = SITE.ogImage,
  twitterTitle,
  twitterDescription,
  canonicalURL = new URL(Astro.url.pathname, SITE.url).href,
  article = false,
  publishDate,
  noindex = false,
  locale = getLocaleFromPathname(Astro.url.pathname),
  alternates = alternatesForPath(Astro.url.pathname),
  routeKey,
} = Astro.props;

const localeInfo = localeMeta[locale];
const pageDescription = description ?? homeCopy[locale].metaDescription;
const pageTitle = title ? (titleSuffix ? `${title} | ${SITE.name}` : title) : homeCopy[locale].metaTitle;
const openGraphTitle = ogTitle ?? pageTitle;
const openGraphDescription = ogDescription ?? pageDescription;
const twitterCardTitle = twitterTitle ?? openGraphTitle;
const twitterCardDescription = twitterDescription ?? openGraphDescription;
const ogImageAbsolute = ogImage.startsWith('http') ? ogImage : `${SITE.url}${ogImage}`;
const searchUrl = new URL(localizedPath(locale, 'blog'), SITE.url).href;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  logo: `${SITE.url}/images/og/default.webp`,
  sameAs: [],
  contactPoint: {
    '@type': 'ContactPoint',
    email: SITE.email,
    contactType: 'editorial',
  },
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: homeCopy[locale].metaDescription,
  inLanguage: localeInfo.htmlLang,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${searchUrl}?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<!DOCTYPE html>
<html lang={localeInfo.htmlLang} class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />

  <!-- Primary Meta -->
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonicalURL} />
  {alternates && Object.entries(alternates).map(([hreflang, href]) => (
    <link rel="alternate" hreflang={hreflang} href={href} />
  ))}

  <!-- Open Graph -->
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={openGraphTitle} />
  <meta property="og:description" content={openGraphDescription} />
  <meta property="og:image" content={ogImageAbsolute} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:locale" content={localeInfo.ogLocale} />
  {publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content={SITE.twitter} />
  <meta name="twitter:title" content={twitterCardTitle} />
  <meta name="twitter:description" content={twitterCardDescription} />
  <meta name="twitter:image" content={ogImageAbsolute} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- RSS -->
  <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />

  <!-- Preconnect for fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  <script
    src="https://analytics.ahrefs.com/analytics.js"
    data-key="yP55gqnaYyxJ2QTGSB0IAA"
    async
  ></script>

  <slot name="head" />
</head>
<body class="min-h-screen flex flex-col">
  <Header locale={locale} alternates={alternates} routeKey={routeKey} />
  <main id="main-content" class="flex-1">
    <slot />
  </main>
  <Footer locale={locale} />

  <!-- Scroll reveal script -->
  <script>
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            revealObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );

    document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));
  </script>
</body>
</html>
