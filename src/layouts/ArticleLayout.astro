---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import RelatedArticles from '@/components/RelatedArticles.astro';
import NewsletterBlock from '@/components/NewsletterBlock.astro';
import CategoryPill from '@/components/CategoryPill.astro';
import { SITE } from '@/data/site';
import type { CollectionEntry } from 'astro:content';

interface Props {
  article: CollectionEntry<'articles'>;
  relatedArticles: CollectionEntry<'articles'>[];
  headings: { depth: number; text: string; slug: string }[];
}

const { article, relatedArticles, headings } = Astro.props;
const { title, metaTitle, metaDescription, category, tags, date, readingTime, excerpt, heroImage, imageAlt, sources, disclaimer } = article.data;

// Preserve absolute URLs (https://...) unchanged; prepend / for relative paths
const ogImage = heroImage.startsWith('http') ? heroImage : (heroImage.startsWith('/') ? heroImage : `/${heroImage}`);
const ogImageAbsolute = ogImage.startsWith('http') ? ogImage : `${SITE.url}${ogImage}`;
const canonicalURL = new URL(`/articles/${article.id}`, SITE.url).href;

const formattedDate = new Intl.DateTimeFormat('fr-FR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: metaDescription,
  image: ogImageAbsolute,
  datePublished: date.toISOString(),
  dateModified: article.data.updatedDate?.toISOString() ?? date.toISOString(),
  author: {
    '@type': 'Organization',
    name: SITE.author,
    url: SITE.url,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    logo: {
      '@type': 'ImageObject',
      url: `${SITE.url}/images/og/default.webp`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL,
  },
  keywords: tags.join(', '),
  articleSection: category,
  inLanguage: 'fr',
  url: canonicalURL,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: category.charAt(0).toUpperCase() + category.slice(1), item: `${SITE.url}/${category}` },
    { '@type': 'ListItem', position: 3, name: title, item: canonicalURL },
  ],
};
---

<BaseLayout
  title={metaTitle ?? title}
  description={metaDescription}
  ogImage={ogImageAbsolute}
  canonicalURL={canonicalURL}
  article={true}
  publishDate={date}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <!-- Article Hero -->
  <section class="relative bg-rdm-bg pt-8 pb-0 overflow-hidden">
    <!-- Breadcrumb -->
    <div class="container-rdm mb-6">
      <nav aria-label="Fil d'Ariane" class="flex items-center gap-2 text-sm text-rdm-gray">
        <a href="/" class="hover:text-rdm-orange transition-colors">Accueil</a>
        <span aria-hidden="true">/</span>
        <a href={`/${category}`} class="hover:text-rdm-orange transition-colors capitalize">{category}</a>
        <span aria-hidden="true">/</span>
        <span class="text-rdm-black truncate max-w-xs">{title}</span>
      </nav>
    </div>

    <!-- Article header -->
    <div class="container-rdm max-w-4xl">
      <div class="mb-4">
        <CategoryPill category={category} />
      </div>
      <h1 class="text-headline font-black text-rdm-black mb-4 leading-tight">{title}</h1>
      <p class="text-lg text-rdm-gray leading-relaxed mb-6">{excerpt}</p>

      <!-- Meta bar -->
      <div class="flex flex-wrap items-center gap-4 text-sm text-rdm-gray pb-6 border-b border-rdm-border">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-full bg-rdm-orange flex items-center justify-center text-white text-xs font-bold">R</div>
          <span class="font-medium text-rdm-black">{SITE.author}</span>
        </div>
        <time datetime={date.toISOString()} class="flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
          </svg>
          {formattedDate}
        </time>
        <span class="flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          {readingTime} min de lecture
        </span>
      </div>
    </div>

    <!-- Hero image -->
    <div class="container-rdm max-w-5xl mt-8">
      <div class="rounded-2xl overflow-hidden aspect-editorial shadow-card">
        <img
          src={heroImage}
          alt={imageAlt}
          class="w-full h-full object-cover"
          loading="eager"
          width="1200"
          height="675"
        />
      </div>
    </div>
  </section>

  <!-- Article body + ToC -->
  <section class="py-12">
    <div class="container-rdm">
      <div class="flex gap-12 lg:gap-16 items-start">
        <!-- Article content -->
        <article class="flex-1 min-w-0 max-w-2xl mx-auto lg:mx-0">
          <div class="prose prose-rdm prose-lg max-w-none">
            <slot />
          </div>

          <!-- Tags -->
          {tags.length > 0 && (
            <div class="mt-10 pt-6 border-t border-rdm-border">
              <p class="text-xs font-semibold uppercase tracking-widest text-rdm-gray mb-3">Mots-clés</p>
              <div class="flex flex-wrap gap-2">
                {tags.map((tag) => (
                  <span class="px-3 py-1 rounded-full bg-rdm-bg text-sm text-rdm-gray border border-rdm-border">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          )}

          <!-- Disclaimer -->
          {disclaimer && (
            <div class="mt-8 p-5 rounded-xl bg-amber-50 border border-amber-200">
              <p class="text-sm text-amber-800">
                <strong>Avis de non-responsabilité :</strong> Cet article est une analyse éditoriale et ne constitue pas un conseil financier, juridique ou fiscal. Toute décision d'investissement doit être précédée d'une consultation auprès de professionnels qualifiés.
              </p>
            </div>
          )}

          <!-- Sources -->
          {sources && sources.length > 0 && (
            <div class="mt-8 p-6 rounded-xl bg-rdm-bg border border-rdm-border">
              <h3 class="text-sm font-bold uppercase tracking-widest text-rdm-gray mb-4">Sources & références</h3>
              <ul class="space-y-2">
                {sources.map((source) => (
                  <li class="text-sm">
                    <a
                      href={source.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-rdm-orange hover:underline flex items-start gap-2"
                    >
                      <svg class="w-4 h-4 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                      </svg>
                      {source.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </article>

        <!-- Sticky Table of Contents -->
        {headings.length > 2 && (
          <aside class="hidden lg:block w-64 flex-shrink-0 sticky top-24 toc-scroll">
            <TableOfContents headings={headings} />
          </aside>
        )}
      </div>
    </div>
  </section>

  <!-- Newsletter CTA after article -->
  <div id="newsletter" class="container-rdm mb-12">
    <NewsletterBlock variant="inline" />
  </div>

  <!-- Related articles -->
  {relatedArticles.length > 0 && (
    <RelatedArticles articles={relatedArticles} />
  )}
</BaseLayout>

<script>
  // Active heading tracking for ToC
  const headings = document.querySelectorAll('article h2, article h3');
  const tocLinks = document.querySelectorAll('.toc-link');

  if (headings.length && tocLinks.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            tocLinks.forEach((link) => {
              link.classList.remove('active');
              if (link.getAttribute('href') === `#${entry.target.id}`) {
                link.classList.add('active');
              }
            });
          }
        });
      },
      { rootMargin: '-20% 0% -60% 0%' }
    );

    headings.forEach((h) => observer.observe(h));
  }
</script>
