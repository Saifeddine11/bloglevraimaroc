---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import NewsletterBlock from '@/components/NewsletterBlock.astro';
import { getCollection } from 'astro:content';
import { getCategoryInfo } from '@/data/categories';
import CategoryIcon from '@/components/CategoryIcon.astro';
import { articleLocale } from '@/i18n/articles';
import { ui } from '@/i18n/ui';
import { absoluteUrl, localizedPath } from '@/i18n/routes';
import { categoryCopies } from '@/i18n/pages';
import { isVisibleInBlogGrid } from '@/lib/articleVisibility';

const cat = getCategoryInfo('analyses');
const allArticles = (await getCollection('articles')).filter(
  (article) => articleLocale(article) === 'fr' && isVisibleInBlogGrid(article),
);
const articles = allArticles
  .filter((a) => a.data.category === 'analyses')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout
  title="Analyses Maroc — Économie, immobilier, tourisme et société"
  description="Analyses de fond sur le Maroc : économie, immobilier, tourisme, infrastructures, culture, société et signaux de marché."
  breadcrumbs={[
    { name: ui.fr.labels.home, item: absoluteUrl(localizedPath('fr', 'home')) },
    { name: categoryCopies.fr.analyses.label },
  ]}
>
  <section class="py-16 bg-rdm-bg border-b border-rdm-border">
    <div class="container-rdm">
      <div class="flex items-center gap-3 mb-4">
        <CategoryIcon name={cat.icon} size={28} class={cat.color} />
        <p class="section-label">{cat.label}</p>
      </div>
      <h1 class="text-headline font-black text-rdm-black mb-4">
        Analyses<br />
        <span class="text-rdm-orange">de marché</span>
      </h1>
      <p class="text-rdm-gray max-w-lg leading-relaxed">
        Nos analyses de fond sur l'économie, l'immobilier, le tourisme et les dynamiques sociales du Maroc.
        Des textes longs, sourcés, écrits pour comprendre — pas pour vendre.
      </p>
    </div>
  </section>

  <section class="py-14">
    <div class="container-rdm">
      {articles.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {articles.map((a) => <ArticleCard article={a} />)}
        </div>
      ) : (
        <p class="text-rdm-gray py-12 text-center">Analyses à venir dans cette rubrique.</p>
      )}
    </div>
  </section>

  <NewsletterBlock />
</BaseLayout>
