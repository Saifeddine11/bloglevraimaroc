---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import NewsletterBlock from '@/components/NewsletterBlock.astro';
import { getCollection } from 'astro:content';
import { getCategoryInfo } from '@/data/categories';
import CategoryIcon from '@/components/CategoryIcon.astro';
import { articleLocale } from '@/i18n/articles';
import { ui } from '@/i18n/ui';
import { absoluteUrl, localizedPath } from '@/i18n/routes';
import { categoryCopies } from '@/i18n/pages';
import { isVisibleInBlogGrid, isVisibleInFeatured } from '@/lib/articleVisibility';

const cat = getCategoryInfo('tourisme');
const allArticles = (await getCollection('articles')).filter(
  (article) => articleLocale(article) === 'fr' && isVisibleInBlogGrid(article),
);
const articles = allArticles
  .filter((a) => a.data.category === 'tourisme')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featured = articles.find(isVisibleInFeatured);
const rest = articles.filter((article) => article.id !== featured?.id);
---

<BaseLayout
  title="Tourisme au Maroc — Tendances, hôtellerie et économie"
  description="Analyses éditoriales sur le tourisme au Maroc : fréquentation, hôtellerie, événements, infrastructures et impact économique."
  breadcrumbs={[
    { name: ui.fr.labels.home, item: absoluteUrl(localizedPath('fr', 'home')) },
    { name: categoryCopies.fr.tourisme.label },
  ]}
>
  <section class="py-16 bg-rdm-bg border-b border-rdm-border">
    <div class="container-rdm">
      <div class="flex items-center gap-3 mb-4">
        <CategoryIcon name={cat.icon} size={28} class={cat.color} />
        <p class="section-label">{cat.label}</p>
      </div>
      <h1 class="text-headline font-black text-rdm-black mb-4">
        Tourisme<br />
        <span class="text-rdm-orange">au Maroc</span>
      </h1>
      <p class="text-rdm-gray max-w-lg leading-relaxed">{cat.description}</p>
      <p class="mt-5 max-w-2xl text-sm text-rdm-gray">
        Dossier de référence : <a
          href="/articles/the-gentlemen-saison-3-maroc-rabat-erfoud/"
          class="font-semibold text-rdm-orange hover:underline"
        >The Gentlemen saison 3 au Maroc — tournage, casting et coulisses</a>.
      </p>
    </div>
  </section>

  <section class="py-14">
    <div class="container-rdm">
      {featured && (
        <div class="mb-12">
          <p class="text-xs font-semibold uppercase tracking-widest text-rdm-gray mb-6">Article récent</p>
          <ArticleCard article={featured} variant="featured" eager />
        </div>
      )}
      {rest.length > 0 && (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {rest.map((article) => <ArticleCard article={article} />)}
        </div>
      )}
      {articles.length === 0 && (
        <p class="text-rdm-gray py-12 text-center">Articles à venir dans cette rubrique.</p>
      )}
    </div>
  </section>

  <NewsletterBlock />
</BaseLayout>
