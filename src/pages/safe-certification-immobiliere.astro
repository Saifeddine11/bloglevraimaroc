              <p class="text-sm leading-relaxed text-white/60">{link.text}</p>
              <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-rdm-orange">
                Lire
                <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </span>
            </a>
          ))}
        </div>
      </div>

      <div>
        <h3 class="mb-5 text-xl font-black text-white">Articles éditoriaux liés</h3>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {internalLinks.map((link) => (
          <a href={link.href} class="group rounded-lg border border-white/10 bg-white/[0.06] p-5 transition-colors hover:border-rdm-orange/70 hover:bg-white/[0.1]">
            <h3 class="mb-2 font-black text-white group-hover:text-rdm-orange">{link.title}</h3>
            <p class="text-sm leading-relaxed text-white/60">{link.text}</p>
            <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-rdm-orange">
              Lire
              <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
              </svg>
            </span>
          </a>
          ))}
        </div>
      </div>
    </div>
  </section>
