      </div>
      <div class="grid gap-4 lg:grid-cols-2">
        {formulas.map((formula) => (
          <article class="rounded-lg border border-rdm-border bg-white p-6 shadow-card">
            <p class="mb-3 text-xs font-bold uppercase text-rdm-orange">{formula.label}</p>
            <p class="text-sm leading-relaxed text-rdm-gray">{formula.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-18 lg:py-24" aria-labelledby="faq-heading">
    <div class="container-rdm">
      <div class="mx-auto max-w-3xl">
        <p class="section-label mb-3">FAQ</p>
        <h2 id="faq-heading" class="mb-8 text-3xl font-black leading-tight text-rdm-black sm:text-4xl">
          Questions fréquentes sur S.A.F.E
        </h2>
        <div class="divide-y divide-rdm-border rounded-lg border border-rdm-border bg-white">
          {faqItems.map((item) => (
            <details class="group p-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left font-bold text-rdm-black">
                {item.question}
                <svg class="h-5 w-5 flex-shrink-0 text-rdm-orange transition-transform group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14" />
                </svg>
              </summary>
              <p class="mt-4 text-sm leading-relaxed text-rdm-gray">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-rdm-black py-18 text-white lg:py-24" aria-labelledby="links-heading">
    <div class="container-rdm">
      <div class="mb-10 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-2xl">
          <p class="mb-3 text-xs font-bold uppercase text-rdm-orange">Lecture recommandée</p>
          <h2 id="links-heading" class="text-3xl font-black leading-tight sm:text-4xl">
            Continuer l’analyse avant d’acheter
