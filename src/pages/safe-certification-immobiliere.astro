---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SafeBadge from '@/components/SafeBadge.astro';
import { SITE } from '@/data/site';
import { SAFE_BRAND } from '@/data/safeCluster';

const seoTitle = SAFE_BRAND;
const pageTitle = SAFE_BRAND;
const metaDescription =
  "S.A.F.E est une méthode internationale propriétaire d'analyse et de présélection immobilière, conçue pour aider les acheteurs et les investisseurs à évaluer un projet immobilier avant toute décision d'acquisition.";
const openGraphDescription =
  "Une méthode internationale propriétaire pour analyser un projet immobilier avant décision d'acquisition, avec des vérifications adaptées au pays concerné.";
const canonicalURL = new URL('/safe-certification-immobiliere/', SITE.url).href;

const checks = [
  {
