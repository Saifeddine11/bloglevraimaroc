---
import LocalizedPage from '@/components/LocalizedPage.astro';
import { safeRouteKeys, routeSlugs, type RouteKey } from '@/i18n/routes';

export function getStaticPaths() {
  return safeRouteKeys.map((routeKey) => ({
    params: { slug: routeSlugs.fr[routeKey] },
    props: { routeKey },
  }));
}

const { routeKey } = Astro.props as { routeKey: RouteKey };
---

<LocalizedPage locale="fr" routeKey={routeKey} />
