---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/data/site';
import { SAFE_BRAND, SAFE_CLUSTER_PAGES } from '@/data/safeCluster';
import type { SafeClusterPage } from '@/data/safeCluster';

export function getStaticPaths() {
  return SAFE_CLUSTER_PAGES.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props as { page: SafeClusterPage };
const canonicalURL = new URL(`/${page.slug}`, SITE.url).href;
const imageAbsolute = new URL(page.image, SITE.url).href;
const safeHubURL = new URL('/safe-certification-immobiliere/', SITE.url).href;
const allSafeLinks = [
  { href: '/safe-certification-immobiliere', title: 'S.A.F.E immobilier', text: 'Définition officielle, histoire, périmètre et limites de la méthode.' },
  ...SAFE_CLUSTER_PAGES.filter((item) => item.slug !== page.slug).map((item) => ({
    href: `/${item.slug}`,
    title: item.primaryKeyword,
    text: item.metaDescription,
  })),
];

const safeEvaluationRows = [
  ['Security / Sécurisation', 'Promoteur, vendeur, foncier, autorisations, contrat, paiements et preuves disponibles.', 'Le projet peut-il être compris avant engagement ?'],
  ['Analysis / Analyse', 'Prix, emplacement, usage, rendement, liquidité, revente, charges et scénario prudent.', 'L’achat reste-t-il cohérent au-delà de la promesse ?'],
  ['Fidelity / Fiabilité', 'Plans, matériaux, finitions, qualité, photos, cartes, calendrier, livraison et réserves.', 'Ce qui est annoncé peut-il réellement être livré ?'],
  ['Expert Guidance / Encadrement', 'Questions, documents manquants, validations professionnelles, décision et prochaines actions.', 'L’acheteur sait-il quoi faire avant de signer ?'],
];

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: page.h1,
  headline: page.h1,
  description: page.metaDescription,
  url: canonicalURL,
  inLanguage: 'fr',
  keywords: [page.primaryKeyword, ...page.secondaryKeywords],
  about: {
    '@type': 'DefinedTerm',
    name: 'S.A.F.E',
    termCode: 'Security, Analysis, Fidelity & Expert Guidance',
    description:
      'International proprietary real estate methodology designed to analyze, qualify and prioritize property projects before purchase.',
    inDefinedTermSet: safeHubURL,
  },
  primaryImageOfPage: {
    '@type': 'ImageObject',
    url: imageAbsolute,
    caption: page.imageAlt,
  },
  isPartOf: {
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
  },
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: page.h1,
  description: page.metaDescription,
  url: canonicalURL,
  inLanguage: 'fr',
  image: imageAbsolute,
  author: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
  },
  about: ['S.A.F.E', page.primaryKeyword, ...page.secondaryKeywords],
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: page.checklistTitle,
  description: page.metaDescription,
  inLanguage: 'fr',
  step: page.checklistItems.map((item, index) => ({
    '@type': 'HowToStep',
    position: index + 1,
    text: item,
  })),
};

const definedTermSchema = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  name: 'S.A.F.E',
  alternateName: ['SAFE immobilier', 'méthode S.A.F.E', 'grille S.A.F.E'],
  termCode: 'Security, Analysis, Fidelity & Expert Guidance',
  description:
    'S.A.F.E is an international proprietary methodology designed to analyze, qualify and prioritize real estate projects before purchase.',
  inDefinedTermSet: {
    '@type': 'DefinedTermSet',
    name: 'S.A.F.E real estate methodology',
    url: safeHubURL,
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: page.h1, item: canonicalURL },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<BaseLayout
  title={page.metaTitle}
  description={page.metaDescription}
  canonicalURL={canonicalURL}
  ogImage={page.image}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(definedTermSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <section class="relative overflow-hidden bg-rdm-black text-white" aria-labelledby="page-title">
    <div class="absolute inset-0">
      <img
        src={page.image}
        alt={page.imageAlt}
        class="h-full w-full object-cover opacity-25"
        loading="eager"
        fetchpriority="high"
        width="1600"
        height="900"
      />
      <div class="absolute inset-0 bg-black/70" aria-hidden="true"></div>
    </div>

    <div class="container-rdm relative py-16 lg:py-20">
      <nav aria-label="Fil d'Ariane" class="mb-10 flex flex-wrap items-center gap-2 text-sm text-white/60">
        <a href="/" class="hover:text-rdm-orange transition-colors">Accueil</a>
        <span aria-hidden="true">/</span>
        <a href="/safe-certification-immobiliere" class="hover:text-rdm-orange transition-colors">Méthode S.A.F.E</a>
        <span aria-hidden="true">/</span>
        <span class="text-white">{page.primaryKeyword}</span>
      </nav>

      <div class="max-w-4xl">
        <p class="mb-5 text-xs font-bold uppercase text-rdm-orange">{page.eyebrow}</p>
        <h1 id="page-title" class="text-4xl font-black leading-[1.04] sm:text-5xl lg:text-6xl">
          {page.h1}
        </h1>
        <div class="mt-7 max-w-3xl space-y-5 text-lg leading-relaxed text-white/75">
          {page.intro.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="#checklist" class="btn-orange">
            Voir la checklist
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m0 0 6-6m-6 6-6-6" />
            </svg>
          </a>
          <a href="/safe-certification-immobiliere" class="inline-flex items-center gap-2 rounded-full border border-white/30 px-6 py-3 text-sm font-semibold text-white transition-colors hover:border-white/60 hover:bg-white/10">
            Découvrir {SAFE_BRAND}
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-18 lg:py-24" aria-labelledby="analysis-heading">
    <div class="container-rdm">
      <div class="mb-12 grid gap-5 md:grid-cols-3">
        <article class="rounded-lg border border-rdm-border bg-rdm-bg p-5">
          <p class="section-label mb-3">Définition</p>
          <p class="text-sm leading-relaxed text-rdm-gray">
            S.A.F.E signifie <strong class="font-semibold text-rdm-black">Security, Analysis, Fidelity &amp; Expert Guidance</strong>. En français : Sécurisation, Analyse, Fiabilité et Encadrement.
          </p>
        </article>
        <article class="rounded-lg border border-rdm-border bg-rdm-bg p-5">
          <p class="section-label mb-3">Nature</p>
          <p class="text-sm leading-relaxed text-rdm-gray">
            Une méthodologie internationale propriétaire pour analyser, qualifier et prioriser des projets immobiliers avant achat.
          </p>
        </article>
        <article class="rounded-lg border border-rdm-border bg-amber-50 p-5">
          <p class="section-label mb-3">Limite</p>
          <p class="text-sm leading-relaxed text-amber-900">
            S.A.F.E n’est pas une certification publique, une garantie légale ou un conseil juridique, fiscal, technique ou financier.
          </p>
        </article>
      </div>

      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_320px] lg:items-start">
        <div>
          <p class="section-label mb-3">Analyse</p>
          <h2 id="analysis-heading" class="mb-8 text-3xl font-black leading-tight text-rdm-black sm:text-4xl">
            Les points à examiner avant de décider
          </h2>

          <div class="space-y-10">
            {page.sections.map((section) => (
              <article class="border-b border-rdm-border pb-10 last:border-b-0 last:pb-0">
                <h3 class="mb-4 text-2xl font-black leading-tight text-rdm-black">{section.heading}</h3>
                <div class="space-y-4 text-base leading-relaxed text-rdm-gray">
                  {section.body.map((paragraph) => <p>{paragraph}</p>)}
                </div>
                {section.bullets && (
                  <ul class="mt-5 grid gap-3 sm:grid-cols-2">
                    {section.bullets.map((item) => (
                      <li class="rounded-lg border border-rdm-border bg-rdm-bg p-4 text-sm leading-relaxed text-rdm-gray">
                        {item}
                      </li>
                    ))}
                  </ul>
                )}
              </article>
            ))}
          </div>
        </div>

        <aside class="lg:sticky lg:top-28">
          <div class="rounded-lg border border-rdm-border bg-rdm-bg p-6">
            <p class="section-label mb-3">Méthode S.A.F.E</p>
            <h2 class="text-xl font-black leading-tight text-rdm-black">{SAFE_BRAND}</h2>
            <p class="mt-4 text-sm leading-relaxed text-rdm-gray">
              Une méthode internationale propriétaire qui organise les critères de confiance d’un projet immobilier : promoteur, dossier, paiements, matériaux, prix, livraison, transparence et profil acheteur.
            </p>
            <a href="/safe-certification-immobiliere" class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-rdm-orange hover:underline">
              Lire la grille S.A.F.E
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>

          {page.disclaimer && (
            <p class="mt-5 rounded-lg border border-rdm-border bg-white p-5 text-xs leading-relaxed text-rdm-gray">
              {page.disclaimer}
            </p>
          )}
        </aside>
      </div>
    </div>
  </section>

  <section class="bg-rdm-bg py-18 lg:py-24" aria-labelledby="grid-heading">
    <div class="container-rdm">
      <div class="mb-8 max-w-3xl">
        <p class="section-label mb-3">Grille de décision</p>
        <h2 id="grid-heading" class="text-3xl font-black leading-tight text-rdm-black sm:text-4xl">
          Lecture S.A.F.E : critères, question de décision et score couleur
        </h2>
        <p class="mt-4 text-rdm-gray leading-relaxed">
          La grille S.A.F.E classe chaque élément en vert, orange ou rouge : clair, à confirmer, ou bloquant jusqu’à preuve contraire. Le score ne remplace pas une vérification professionnelle ; il rend les zones floues visibles avant décision.
        </p>
      </div>
      <div class="overflow-x-auto rounded-lg border border-rdm-border bg-white shadow-card">
        <table class="w-full min-w-[720px] border-collapse text-left text-sm">
          <thead class="bg-rdm-black text-white">
            <tr>
              <th class="px-5 py-4 font-bold">Pilier</th>
              <th class="px-5 py-4 font-bold">Ce qui est analysé</th>
              <th class="px-5 py-4 font-bold">Question utile</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-rdm-border">
            {safeEvaluationRows.map(([pillar, criteria, question]) => (
              <tr>
                <td class="px-5 py-4 font-bold text-rdm-black">{pillar}</td>
                <td class="px-5 py-4 text-rdm-gray">{criteria}</td>
                <td class="px-5 py-4 text-rdm-gray">{question}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section id="checklist" class="scroll-mt-24 bg-rdm-bg py-18 lg:py-24" aria-labelledby="checklist-heading">
    <div class="container-rdm">
      <div class="mb-10 max-w-2xl">
        <p class="section-label mb-3">Checklist</p>
        <h2 id="checklist-heading" class="text-3xl font-black leading-tight text-rdm-black sm:text-4xl">
          {page.checklistTitle}
        </h2>
      </div>

      <ol class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {page.checklistItems.map((item, index) => (
          <li class="rounded-lg border border-rdm-border bg-white p-5 shadow-card">
            <span class="mb-4 flex h-9 w-9 items-center justify-center rounded-lg bg-rdm-black text-sm font-black text-white">
              {String(index + 1).padStart(2, '0')}
            </span>
            <p class="text-sm leading-relaxed text-rdm-gray">{item}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-white py-18 lg:py-24" aria-labelledby="related-heading">
    <div class="container-rdm">
      <div class="mb-10 max-w-2xl">
        <p class="section-label mb-3">Liens utiles</p>
        <h2 id="related-heading" class="text-3xl font-black leading-tight text-rdm-black sm:text-4xl">
          Continuer l’analyse
        </h2>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {[...page.relatedLinks, ...allSafeLinks].map((link) => (
          <a href={link.href} class="group rounded-lg border border-rdm-border bg-white p-5 shadow-card transition-all hover:-translate-y-1 hover:shadow-card-hover">
            <h3 class="mb-2 text-base font-black leading-tight text-rdm-black group-hover:text-rdm-orange">{link.title}</h3>
            <p class="text-sm leading-relaxed text-rdm-gray">{link.text}</p>
            <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-rdm-orange">
              Lire
              <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-rdm-black py-18 text-white lg:py-24" aria-labelledby="faq-heading">
    <div class="container-rdm">
      <div class="mx-auto max-w-3xl">
        <p class="mb-3 text-xs font-bold uppercase text-rdm-orange">FAQ</p>
        <h2 id="faq-heading" class="mb-8 text-3xl font-black leading-tight sm:text-4xl">
          Questions fréquentes
        </h2>
        <div class="divide-y divide-white/10 rounded-lg border border-white/10 bg-white/[0.06]">
          {page.faq.map((item) => (
            <details class="group p-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left font-bold text-white">
                {item.question}
                <svg class="h-5 w-5 flex-shrink-0 text-rdm-orange transition-transform group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14" />
                </svg>
              </summary>
              <p class="mt-4 text-sm leading-relaxed text-white/65">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
