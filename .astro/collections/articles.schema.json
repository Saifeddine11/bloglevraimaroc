{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "urlSlug": {
      "type": "string"
    },
    "locale": {
      "default": "fr",
      "type": "string",
      "enum": [
        "fr",
        "en",
        "es",
        "nl"
      ]
    },
    "translationKey": {
      "type": "string"
    },
    "metaTitle": {
      "type": "string"
    },
    "metaDescription": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "immobilier",
        "tourisme",
        "investissement",
        "quartiers",
        "guides",
        "analyses"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "updatedDate": {
      "type": "string",
      "format": "date-time"
    },
    "readingTime": {
      "type": "number"
    },
    "excerpt": {
      "type": "string"
    },
    "heroImage": {
      "type": "string"
    },
    "imageAlt": {
      "type": "string"
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "sources": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "url"
        ]
      }
    },
    "disclaimer": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "metaDescription",
    "category",
    "tags",
    "date",
    "readingTime",
    "excerpt",
    "heroImage",
    "imageAlt"
  ]
}